# Private dashboard: automatic HTTPS plus a login for every request.
# DASHBOARD_HOST is set in a server-only systemd drop-in, never in Git.
# Logins live in /etc/caddy/dashboard_users; manage them with dashboard_user.sh.
{$DASHBOARD_HOST} {
	basicauth {
		import /etc/caddy/dashboard_users
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'"
	}
	encode gzip
	reverse_proxy 127.0.0.1:8090
}

# Other sites hosted on the same server keep their own files here (none is fine).
import /etc/caddy/conf.d/*.caddy
