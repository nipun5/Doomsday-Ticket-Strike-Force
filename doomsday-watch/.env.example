# Run locally: copy to .env and fill in two or more channels.
# On a server, keep .env outside Git and chmod 600.
POLL_SECONDS=600
STATE_FILE=state.json

# Optional external dead-man check. Create a 10-minute check at healthchecks.io,
# allow at least 5 minutes grace, and paste its private ping URL here.
HEALTHCHECK_URL=

# Telegram: create a bot with BotFather, start a chat with it, then use your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated additional private chat IDs; each recipient is
# tracked separately so a failed send to one friend can be retried safely.
TELEGRAM_EXTRA_CHAT_IDS=

# Discord DM: a bot token and your numeric Discord user ID.
# The bot must be able to DM you (for example, share a server and allow its DMs).
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Email: SMTP account/app password (for example, Gmail SMTP with an app password).
# DigitalOcean blocks SMTP ports; use Resend HTTPS below on a Droplet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Email from a DigitalOcean Droplet: create a free Resend account and a
# Sending-access API key. With onboarding@resend.dev, EMAIL_TO must match the
# address used to sign up to Resend. Use setup_email.py for hidden-key input.
RESEND_API_KEY=
RESEND_FROM=Doomsday Watch <onboarding@resend.dev>

# Optional phone push through ntfy (install its mobile app and subscribe to topic).
# Use a long random private topic; public ntfy.sh topics are readable by anyone
# who knows the topic name.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
